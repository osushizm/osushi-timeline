---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('gameblog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (d: Date) => `${d.getUTCFullYear()}.${pad(d.getUTCMonth() + 1)}.${pad(d.getUTCDate())}`;
---
<Base title="ゲームブログ | お寿司のタイムライン" current="game" description="遊んでいるゲーム、クリアしたゲームについてのブログのバックログ一覧。">
  <section class="block">
    <SectionHead icon="🎮" title="ゲームブログ" en="GAME" />
    {entries.length === 0 ? (
      <div class="archive-banner">まだ記事がありません。templates/gameblog.md をコピーして最初の1件を追加してください。</div>
    ) : (
      <ul class="diary-list">
        {entries.map((e) => (
          <li>
            <a href={`/game/${e.id}/`}>
              <time>{fmt(e.data.date)}</time>
              <div class="dt">{e.data.title}</div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
