---
import '../styles/global.css';
interface Props { title?: string; current?: string; updated?: string; description?: string }
const {
  title = 'お寿司のタイムライン',
  current = '',
  updated,
  description = 'お寿司の「今」が流れてくるところ ── 日々のログとランクの遍歴。',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.svg', Astro.site);
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="お寿司のタイムライン" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru:wght@400;500&family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="wrap">
    <header class="site">
      <h1 class="site-title"><a href="/">🍣 お寿司のタイムライン</a></h1>
      <p class="tagline">── お寿司の「今」が流れてくるところ ──</p>
      {updated && <span class="updated">最終更新:{updated}</span>}
      <nav class="global">
        <a href="/" aria-current={current === 'home' ? 'page' : undefined}>いま</a>
        <a href="/tech/" aria-current={current === 'tech' ? 'page' : undefined}>テック</a>
        <a href="/game/" aria-current={current === 'game' ? 'page' : undefined}>ゲーム</a>
        <a href="/diary/" aria-current={current === 'diary' ? 'page' : undefined}>日記</a>
      </nav>
    </header>
    <div class="lane" aria-hidden="true">
      <div class="lane-track">
        {Array.from({ length: 2 }).map(() => (
          <>
            <span>🍣</span><span>🍤</span><span>🍙</span><span>🍵</span><span>🥢</span><span>🍣</span><span>🐟</span><span>🍮</span>
            <span>🍣</span><span>🍤</span><span>🍙</span><span>🍵</span><span>🥢</span><span>🍣</span><span>🐟</span><span>🍮</span>
          </>
        ))}
      </div>
    </div>
    <slot />
    <footer class="site">
      <div class="plates">🍽️🍽️🍽️</div>
      お寿司のタイムライン — シャリの上でまた来週。
      <div class="footer-links"><a href="/archive/">アーカイブ</a></div>
    </footer>
  </div>
</body>
</html>
